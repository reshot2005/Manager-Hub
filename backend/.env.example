# =============================================================================
# Manager Hub — environment (NEVER commit real secrets)
# Production: inject via Vercel / Doppler / Vault — do not rely on .env files.
# =============================================================================

# HUB database (app read/write). Prefer a least-privilege DB role (not owner/superuser).
# Neon: use a private/restricted connection + IP allowlist where available.
DATABASE_URL=

# Optional: set true once CA verification is configured for Neon/RDS
# DB_SSL_REJECT_UNAUTHORIZED=true

PORT=4100

# Auth — use a long random secret (32+ chars). Rotate if ever leaked.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Short-lived access tokens (refresh via /api/auth/refresh)
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# Comma-separated frontend origins only (never *)
CORS_ORIGIN=http://localhost:5173

# Protects /api/sync/cron and /api/backup/cron
CRON_SECRET=replace_with_random_hex
# ALLOW_INSECURE_CRON=true   # local only — never in production

# Gemini — chat only; never expose to frontend
GEMINI_API_KEY=your_gemini_api_key
# Preferred model first; on 429/quota the API auto-rotates through GEMINI_MODELS
GEMINI_MODEL=gemini-2.5-flash-lite
# Comma-separated free/cheap fallbacks (tried in order after GEMINI_MODEL)
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest,gemini-2.0-flash-lite
# Optional: skip a model for N ms after quota (default 300000 = 5 min)
# GEMINI_MODEL_COOLDOWN_MS=300000

# Risk scoring (daily job after sync)
# RISK_WINDOW_DAYS=14
# RISK_WEIGHT_ATTENDANCE=1
# RISK_WEIGHT_TASK=1
# RISK_WEIGHT_EOD=1
# RISK_HIGH_BELOW=50
# RISK_MEDIUM_BELOW=75

# Alerts
# ALERT_COOLDOWN_HOURS=48
# ALERT_TEAM_ABSENCE_PCT=15
# ALERT_SLACK_WEBHOOK_URL=
# ALERT_EMAIL_WEBHOOK_URL=
# INTEL_CRON=15 2 * * *

# Source DBs — READ-ONLY credentials for sync jobs ONLY (not AI / not public routes)
SPRINTBOARD_DATABASE_URL=
ATS_DATABASE_URL=
ATTENDANCE_DATABASE_URL=

# Optional HTTP API fallback (service accounts — sync only)
SPRINTBOARD_URL=
SPRINTBOARD_EMAIL=
SPRINTBOARD_PASSWORD=
ATS_URL=
ATS_EMAIL=
ATS_PASSWORD=

SYNC_CRON=*/5 * * * *
AUTO_SYNC_ON_START=true
SYNC_ROTATE_MINUTES=5
SYNC_EOD_LOOKBACK_DAYS=60
SYNC_ATTENDANCE_LOOKBACK_DAYS=90

# Rate limits
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_AUTH_PER_15M=20
RATE_LIMIT_CHAT_PER_MIN=20

# Backups (every 3 days via cron) — store OFF the primary DB host
BACKUP_DIR=./backups
BACKUP_RETENTION_CYCLES=5
# BACKUP_UPLOAD_URL=https://your-object-storage-presigned-put-url
# BACKUP_UPLOAD_TOKEN=

# First admin — required once; never logged. Set SEED_MANAGER_PASSWORD_FORCE=true to rotate.
SEED_MANAGER_EMAIL=manager@hub.local
SEED_MANAGER_PASSWORD=
SEED_MANAGER_NAME=Hub Manager
# SEED_MANAGER_PASSWORD_FORCE=true

# Frontend (Vercel): leave empty so browser uses same-origin /api
# VITE_API_BASE_URL=/api
